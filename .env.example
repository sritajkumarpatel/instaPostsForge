# Copy this file to .env and fill in the values. Never commit .env.
# The same names are used as GitHub Actions secrets for the daily run.
# Each profile in config/profiles.yaml names the variables it reads, so a second
# account just needs a second set with a different prefix.

# --- Claude: photo analyst, planner, caption writer, hashtag strategist, reviewer ---
ANTHROPIC_API_KEY=

# --- Instagram account for the "main" profile ---
# Long-lived Instagram User access token (Instagram API with Instagram Login), with the
# instagram_business_content_publish and instagram_business_manage_insights permissions.
IG_MAIN_ACCESS_TOKEN=
# Optional: your Instagram professional account ID. Looked up from the token if empty.
IG_MAIN_USER_ID=

# --- Google Drive (where your photos live) ---
# Share link of the photo folder. Kept out of the public config so nobody can browse it.
DRIVE_FOLDER_MAIN=
# API key with the Drive API enabled; the folder must be shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=
# Alternative to the API key, for a privately shared folder (set auth: service_account).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# --- GitHub (stages the day's photo in this public repo for about a minute) ---
# Not needed in GitHub Actions, which provides both automatically.
# For local `forge post`: a fine-grained token with Contents read/write on this repo.
GITHUB_TOKEN=
GITHUB_REPOSITORY=sritajkumarpatel/instaPostsForge

# --- Optional switches ---
# false posts single photos only; true allows multi-photo posts. Empty: config/profiles.yaml decides.
MULTI_PHOTO=
