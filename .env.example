# Copy this file to .env and fill in the values. Never commit .env.
# Each profile in config/profiles.yaml names the variables it reads, so you
# can add more accounts by adding more variables with a different prefix.

# --- Claude (captions, quotes, hashtags) ---
ANTHROPIC_API_KEY=

# --- Instagram account for the "main" profile ---
# Long-lived Instagram User access token (Instagram API with Instagram Login).
IG_MAIN_ACCESS_TOKEN=
# Optional: your Instagram professional account ID. Looked up from the token if empty.
IG_MAIN_USER_ID=

# --- Google Drive (photo source) ---
# Option A: API key, for folders shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=
# Option B: path to a service-account JSON key, for folders shared privately
# with the service account's email address.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# --- Temporary public image hosting (S3-compatible, e.g. Cloudflare R2) ---
# Instagram downloads each photo from a public URL; the pipeline uploads the
# prepared JPEG here, hands Instagram a short-lived link, then deletes it.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
